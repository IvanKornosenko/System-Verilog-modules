//traffic_light_tb
`timescale 1ns/1ps
module traffic_light_tb;
//ОБЪЯВЛЯЕМ СИГНАЛЫ
    logic clk;
    logic rst_n;
    logic red'
    logic yellow;
    logic green;
//DUT (наш светофор)
    traffic_light dut (
        .clk(clk),
        .rst_n(rst_n),
        .red(red),
        .yellow(yellow),
        .green(green)
    );
//ГЕНЕРАЦИЯ clk, надо запомнить, что 10 нс это 100 MHz
    initial clk = 0
    always #5 clk = ~clk;

//СТИМУЛЫ, начальные значения, работа и конец симуляции
    initial 
    begin
        rst_n = 0;                  //Это значение для данного сигнала, в самом начале симуляции
//Нам нужно подержать этот сьрос примерно 20 нс
    #20;
    rst_n = 1;                      //Теперь переводим сброс в 1

    //Даем поработать схеме
    #500;
    //Завершение симуляции
    $stop;
    end
endmodule



